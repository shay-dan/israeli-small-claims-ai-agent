# Copy to .env.postgres and replace both passwords with long random values.
POSTGRES_ADMIN_PASSWORD=replace-with-a-random-secret
BUG_REPORTS_WRITER_PASSWORD=replace-with-a-different-random-secret
BUG_REPORTS_DATABASE_URL=postgresql://bug_report_writer:replace-with-a-different-random-secret@127.0.0.1:5432/small_claims_bug_reports?sslmode=disable
APP_VERSION=local
